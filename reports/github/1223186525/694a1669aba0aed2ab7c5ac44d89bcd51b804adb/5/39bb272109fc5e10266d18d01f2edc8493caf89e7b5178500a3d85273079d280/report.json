  "assessments": [
    {
      "candidate_id": "76b0d0e8fdd50abcb6fcc2f6fc8a38be057c7b5e222e1362d61797f2e3f5428c",
      "evidence_ids": [
        "76b0d0e8fdd50abcb6fcc2f6fc8a38be057c7b5e222e1362d61797f2e3f5428c"
