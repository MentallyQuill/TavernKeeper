{
  "name": "tavernkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run workflows:check",
    "workflows:check": "node scripts/check-workflow-policy.mjs",
    "contracts:generate": "tsx scripts/generate-contract-schemas.ts",
    "scanners:install": "tsx scripts/install-scanners.mjs",
    "scanners:verify": "tsx scripts/verify-scanners.mjs",
    "scanners:smoke": "tsx scripts/smoke-scanners.ts",
    "reconcile": "tsx src/cli/reconcile.ts",
    "targeted-scan": "tsx src/cli/targeted-scan.ts",
    "prepare-target": "tsx src/cli/prepare-target.ts",
    "review-target": "tsx src/cli/review-target.ts",
    "provider:check": "tsx src/cli/provider-check.ts",
    "jsonrepair:check": "tsx src/cli/jsonrepair-check.ts",
    "probe-outcome": "tsx src/cli/probe-outcome.ts",
    "finalize-target": "tsx src/cli/finalize-target.ts",
    "transition-result": "tsx src/cli/transition-result.ts",
    "exhausted": "tsx src/cli/exhausted.ts",
    "publish": "tsx src/cli/publish.ts",
    "artifact-transport": "tsx src/cli/artifact-transport.ts",
    "prepared-evidence": "tsx src/cli/prepared-evidence.ts",
    "retry": "tsx src/cli/retry.ts",
    "queue:sync": "tsx src/cli/sync-queue.ts",
    "state:migrate": "tsx src/cli/migrate-state.ts",
    "policy-rescan": "tsx src/cli/policy-rescan.ts",
    "site:build": "tsx src/cli/build-site.ts"
  },
  "dependencies": {
    "@nodesecure/js-x-ray": "16.0.0",
    "tar": "7.5.22",
    "webcrack": "2.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ajv": "^8.18.0",
    "prettier": "^3.9.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
