{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mentallyquill.github.io/TavernKeeper/schemas/scan-report.v2.schema.json",
  "title": "TavernKeeper V2 complete automated scan report",
  "type": "object",
  "properties": {
    "report_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "report_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "supersedes_report_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "scanner_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "scanner_policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "prompt_policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "source_id": { "type": "string", "pattern": "^github-[1-9][0-9]*$" },
    "provider": { "type": "string", "const": "github" },
    "repository_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "repository": { "type": "string", "pattern": "^[^/\\s]+\\/[^/\\s]+$" },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https:\\/\\/github\\.com\\/.*"
    },
    "target_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "mode": { "type": "string", "enum": ["standard", "deep"] },
    "schema_version": { "type": "number", "const": 2 },
    "history": {
      "type": "object",
      "properties": {
        "base_sha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "commits": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "required": ["base_sha", "commits"],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "inventory": {
          "type": "object",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "eligible_text_files": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "eligible_text_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "excluded": {
              "type": "object",
              "properties": {
                "dependency_lockfiles": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "vendored_dependencies": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "generated_bundles": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "minified_files": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "binaries": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "archives": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "oversized_files": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                },
                "unsafe_entries": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["files", "bytes"],
                  "additionalProperties": false
                }
              },
              "required": [
                "dependency_lockfiles",
                "vendored_dependencies",
                "generated_bundles",
                "minified_files",
                "binaries",
                "archives",
                "oversized_files",
                "unsafe_entries"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "files",
            "bytes",
            "eligible_text_files",
            "eligible_text_bytes",
            "excluded"
          ],
          "additionalProperties": false
        },
        "tools": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "version": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
              },
              "status": {
                "type": "string",
                "enum": ["completed", "not-applicable"]
              }
            },
            "required": ["name", "version", "status"],
            "additionalProperties": false
          }
        },
        "model": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "const": "completed" },
            "endpoint_origin": { "type": "string", "format": "uri" },
            "provider": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
            },
            "input_chunks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed_chunks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cache_read_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "roles": {
              "type": "object",
              "properties": {
                "analyzer": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["required", "completed"],
                  "additionalProperties": false
                },
                "challenger": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["required", "completed"],
                  "additionalProperties": false
                },
                "arbiter": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["required", "completed"],
                  "additionalProperties": false
                }
              },
              "required": ["analyzer", "challenger", "arbiter"],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "endpoint_origin",
            "provider",
            "model",
            "input_chunks",
            "completed_chunks",
            "input_tokens",
            "output_tokens",
            "cache_read_tokens",
            "reasoning_tokens",
            "total_tokens",
            "roles"
          ],
          "additionalProperties": false
        },
        "evidence_validation": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "const": "completed" },
            "validated_findings": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["status", "validated_findings"],
          "additionalProperties": false
        }
      },
      "required": ["inventory", "tools", "model", "evidence_validation"],
      "additionalProperties": false
    },
    "result": { "type": "string", "enum": ["teal", "red"] },
    "finding_counts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actionable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "severity": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "high": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "medium": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "low": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["critical", "high", "medium", "low", "info"],
          "additionalProperties": false
        },
        "confidence": {
          "type": "object",
          "properties": {
            "high": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "medium": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "low": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["high", "medium", "low"],
          "additionalProperties": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["category", "count"],
            "additionalProperties": false
          }
        },
        "actionable_severity": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "high": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "medium": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["critical", "high", "medium"],
          "additionalProperties": false
        },
        "disposition": {
          "type": "object",
          "properties": {
            "confirmed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "not_supported": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inconclusive": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["confirmed", "not_supported", "inconclusive"],
          "additionalProperties": false
        }
      },
      "required": [
        "total",
        "actionable",
        "severity",
        "confidence",
        "categories",
        "actionable_severity",
        "disposition"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:_-]{0,79}$"
          },
          "rule_id": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "line_start": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "line_end": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              { "type": "null" }
            ]
          },
          "evidence_sha": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              { "type": "null" }
            ]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "remediation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reference_url": { "type": "string", "format": "uri" },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "disposition": {
            "type": "string",
            "enum": ["confirmed", "not-supported", "inconclusive"]
          },
          "automated_review": {
            "type": "object",
            "properties": {
              "analyzer_policy": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
              },
              "challenger_policy": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
              },
              "arbiter_policy": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
              }
            },
            "required": [
              "analyzer_policy",
              "challenger_policy",
              "arbiter_policy"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "origin",
          "rule_id",
          "category",
          "severity",
          "confidence",
          "path",
          "line_start",
          "line_end",
          "evidence_sha",
          "title",
          "explanation",
          "fingerprint",
          "disposition",
          "automated_review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "report_id",
    "report_version",
    "supersedes_report_id",
    "scanner_version",
    "scanner_policy_version",
    "prompt_policy_version",
    "source_id",
    "provider",
    "repository_id",
    "repository",
    "canonical_url",
    "target_sha",
    "completed_at",
    "mode",
    "schema_version",
    "history",
    "coverage",
    "result",
    "finding_counts",
    "findings"
  ],
  "additionalProperties": false
}
